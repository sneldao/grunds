# Grunds — local environment template. Copy to .env and fill in values.
# .env is gitignored; never commit real keys. See README "3D asset pipeline".
# Docs: https://docs.mint.gg/developers/quickstart

# Mint API key (server-side only). Create at https://platform.mint.gg.
MINT_API_KEY=

# Convex (Convex phase). Leave empty until deployed.
CONVEX_DEPLOYMENT=
CONVEX_URL=

# OpenAI (patron persona prose, server-side actions only).
OPENAI_API_KEY=
OPENAI_MODEL=

# Firecrawl (commodity-news seed for the event deck, server-side action only).
FIRECRAWL_API_KEY=

# AgentMail (Roaster's Letter inbox).
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=

# SandBase gateway (City Remix — MiniMax M3.1 flash locality packs,
# server-side action only). Console: https://www.sandbase.ai
# Endpoint: https://api.sandbase.ai/v1
SANDBASE_API_KEY=
SANDBASE_MODEL=
# Max uncached SandBase calls per UTC day (packs cache 30 days per city).
SANDBASE_DAILY_BUDGET=

# Tripo v3 (Generative District — Tripothon S1, server-side only).
# Console: https://platform.tripo3d.ai · Docs: https://developers.tripo3d.ai
# Webhook: console Settings → Webhooks → https://<deployment>.convex.site/tripo/webhook
TRIPO_API_KEY=
TRIPO_WEBHOOK_SECRET=
# Max text-to-model tasks this deployment may create per UTC day.
TRIPO_DAILY_BUDGET=50

# Mint (generative-district fallback provider, server-side only).
# Console: https://platform.mint.gg · Docs: https://docs.mint.gg
MINT_API_KEY=
# Max model/asset-pack operations per UTC day (~250 credits each at `fast`).
MINT_DAILY_BUDGET=10
TAVILY_API_KEY=

# Meshy (offline asset vendoring via tools/vendor-meshy.mjs — never runtime).
# Console: https://www.meshy.ai/developers/keys · Docs: https://docs.meshy.ai/en/api
MESHY_API_KEY=

# Hyper3D Rodin (offline asset vendoring via tools/vendor-hyper3d.mjs +
# server-side franchise describe path via convex/rodin.ts).
# Console: https://hyper3d.ai/workspace/api-dashboard · Docs: https://docs.hyper3d.ai
# Basic access (Creator) covers Gen-2.5-Low/Extreme-Low + rigging; Medium+
# needs Full access (Business). Tool defaults to Gen-2.5-Low + 10k faces.
RODIN_API_KEY=
# Max Rodin text-to-3D tasks this deployment may create per UTC day.
RODIN_DAILY_BUDGET=10
