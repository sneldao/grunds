{
  "name": "grunds",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Grunds — The District: Convex backend + Three.js floor",
  "scripts": {
    "test": "node --experimental-vm-modules --test --test-concurrency=1 web/test/*.mjs",
    "test:fast": "node --experimental-vm-modules --test --test-concurrency=1 $(cd web/test && ls *.mjs | grep -vxF -f ../../tools/slow-tests.txt | sed 's|^|web/test/|')",
    "test:slow": "node --experimental-vm-modules --test --test-concurrency=1 $(cd web/test && ls *.mjs | grep -xF -f ../../tools/slow-tests.txt | sed 's|^|web/test/|')",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "typecheck": "tsc --noEmit",
    "build:dist": "sh tools/build-dist.sh",
    "preview:local": "node tools/preview-local.mjs",
    "test:browser": "node tools/test-browser.mjs",
    "stage:site": "node tools/stage-site.mjs",
    "upload:site": "npx @convex-dev/static-hosting upload -d dist",
    "deploy:site": "npm run build:dist && npx convex dev --once && npx @convex-dev/static-hosting upload -d dist"
  },
  "dependencies": {
    "@convex-dev/static-hosting": "^0.2.1",
    "convex": "^1.26.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^22.20.2",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "terser": "^5.51.2",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  }
}
